<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="vibeload_history.db" />
        <include domain="sharedpref" path="vibeload_preferences.xml" />
    </device-transfer>
</data-extraction-rules>
